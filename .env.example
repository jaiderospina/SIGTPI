# ─────────────────────────────────────────────────────────────────────────────
# SIGTPI v2.0  —  Variables de entorno (copiar a .env y completar)
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sigtpi
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sigtpi

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_DB=0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sigtpi
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=sigtpi

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_minimum_32_chars_random_string
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── PKI Interno ───────────────────────────────────────────────────────────────
PKI_SERVICE_URL=http://pki-service:8000
PKI_CA_CERT_PATH=/app/certs/ca.crt
PKI_SIGN_CERT_PATH=/app/certs/sign.crt
PKI_SIGN_KEY_PATH=/app/certs/sign.key

# ── Servicios internos (URLs entre contenedores) ──────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8000
USER_SERVICE_URL=http://user-service:8000
ACADEMIC_REGISTRY_URL=http://academic-registry:8000
TUTORING_SERVICE_URL=http://tutoring-service:8000
TI_MANAGEMENT_URL=http://ti-management:8000
SESSION_SERVICE_URL=http://session-service:8000
EVALUATION_SERVICE_URL=http://evaluation-service:8000
DOCUMENT_SERVICE_URL=http://document-service:8000
SIMILARITY_SERVICE_URL=http://similarity-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
REPORT_SERVICE_URL=http://report-service:8000
PKI_SERVICE_URL=http://pki-service:8000

# ── Almacenamiento ────────────────────────────────────────────────────────────
FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=200

# ── SMTP interno (Postal) ─────────────────────────────────────────────────────
SMTP_HOST=postal
SMTP_PORT=25
SMTP_FROM_EMAIL=noreply@sigtpi.institucion.edu.co
SMTP_FROM_NAME=SIGTPI

# ── Jitsi WebRTC ─────────────────────────────────────────────────────────────
JITSI_BASE_URL=https://meet.sigtpi.local
JITSI_APP_ID=sigtpi
JITSI_APP_SECRET=change_me_in_production

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Configuración académica ───────────────────────────────────────────────────
DEFAULT_SESSION_TIMEOUT_MINUTES=30
DELAY_ALERT_LEVEL1_DAYS=7
DELAY_ALERT_LEVEL2_DAYS=0
DELAY_ALERT_LEVEL3_DAYS=14
DELAY_ALERT_LEVEL4_DAYS=30
SIMILARITY_THRESHOLD_PERCENT=20
